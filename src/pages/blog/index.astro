---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.date))
  .sort((a, b) => b.data.date!.getTime() - a.data.date!.getTime());
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="Notes — Lucio DMS" description="Engineering notes, decisions, and the occasional dead end from the people building Lucio DMS.">
  <SiteHeader />
  <main id="top">
    <section class="split sand" id="notes">
      <div class="l"><p class="eye">From the team</p><h1 class="d2">Notes on how <br><em>we built this.</em></h1><p class="d2s max">A zine from the people building Lucio DMS. Engineering notes, decisions, and the occasional dead end.</p></div>
      <div class="r">
        {posts.length === 0 ? (
          <p class="p" style="color:var(--soft)">Nothing published yet.</p>
        ) : (
          <ol class="zine">
            {posts.map(({ id, data }) => (
              <li><a href={`/blog/${id}`}><span class="no">{data.series}</span><span class="t">{data.title}</span><span class="m">{data.summary}</span><span class="d">{fmt.format(data.date!)}</span></a></li>
            ))}
          </ol>
        )}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
