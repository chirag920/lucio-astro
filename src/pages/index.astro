---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Hero from '../components/sections/Hero.astro';
import Versions from '../components/sections/Versions.astro';
import BeforeAfter from '../components/sections/BeforeAfter.astro';
import Curation from '../components/sections/Curation.astro';
import Search from '../components/sections/Search.astro';
import Governance from '../components/sections/Governance.astro';
import Stats from '../components/sections/Stats.astro';
import Notes from '../components/sections/Notes.astro';
import AboutTeaser from '../components/sections/AboutTeaser.astro';
import Faq from '../components/sections/Faq.astro';
import Evaluate from '../components/sections/Evaluate.astro';
---
<BaseLayout
  title="Lucio DMS — The Information Architecture for Law Firms"
  description="Every document keeps a single version history. Your ethical walls apply in every tool. Your current DMS stays where it is."
>
  <SiteHeader />
  <!-- Each section component renders a bare <section>, so `main > section` styles still apply. -->
  <main id="top">
    <Hero />
    <Versions />
    <BeforeAfter />
    <Curation />
    <Search />
    <Governance />
    <Stats />
    <Notes />
    <AboutTeaser />
    <Faq />
    <Evaluate />
  </main>
  <SiteFooter />
</BaseLayout>
