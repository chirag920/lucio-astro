---
/** Landing-page Engineering Notes list. Reads the `notes` collection; drafts appear nowhere. */
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="split rv notes sand" id="notes">
  <div class="l"><h2 class="d2">Engineering Notes</h2><p class="lead">How we built Lucio DMS, written by the people who built it. Three notes on the decisions that shaped the product, including the ideas we tried and dropped.</p><div style="margin-top:36px"><a class="btn btn--primary" href="/notes">Read the notes</a></div></div>
  <div class="r">
    <ol class="zine">
      {notes.map(({ data }) => (
        <li><a href={`/notes#n${data.order}`}><span class="no">{pad(data.order)}</span><span class="t">{data.title}</span><span class="m">{data.summary}</span><span class="d">{data.minutes} min</span></a></li>
      ))}
    </ol>
  </div>
</section>
