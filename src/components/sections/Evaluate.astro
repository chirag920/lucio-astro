---
/* v23 evaluate: email only — the Firm field is gone from the design. Backend unchanged:
   POSTs to /api/inquiry, which stores the row in D1. */
---
<section class="split rv brand" id="evaluate">
  <div class="l"><h2 class="d2">Leave your email.<br>We'll write back.</h2><p class="lead">We're working with a few firms at a time right now, so we'd rather talk than sign you up. Someone from the team will reply within a few days.</p></div>
  <div class="r"><form class="form" id="inq" novalidate method="post" action="/api/inquiry">
      <input type="email" name="email" placeholder="Work email" autocomplete="email" aria-label="Work email" required>
      {/* A textarea, not an input, so the email field stays `.form input:only-of-type` and spans
          the row per the v23 CSS. Bots fill it either way; people and screen readers never see it. */}
      <textarea name="website" rows="1" tabindex="-1" autocomplete="off" aria-hidden="true"
             style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0"></textarea>
      <button class="btn btn--primary" type="submit">Get in touch</button>
      <p class="fine">A person replies. We don't share or add your address to a mailing list.</p>
      <p class="fine" id="inq-error" role="alert" style="display:none;color:#F5C4A0"></p></form>
    <div class="sent" id="sent" role="status">Thanks. We'll be in touch.<small>Someone from the team will reply within a few days.</small></div></div>
</section>
<script>
  import '../../scripts/inquiry-form';
</script>
