---
import Program from '../Program.astro';
const stages = ['Draft', 'Auction draft', 'Negotiation', 'Signing', 'Executed'];
---
<section class="split rv" id="versions">
  <div class="l tint"><p class="eye">Versions and milestones</p><h2 class="d2">Every document <br>keeps <em>one history.</em></h2><p class="d2s max">Milestones are part of it.</p><p class="p" style="margin-top:28px;max-width:44ch;color:#4F4C6B">A new version is a deliberate act. Name the moment when you version up, and the label lives on the version, not in the file name.</p></div>
  <div class="r">
    <Program complete title="Share Purchase Agreement — Brightline Labs" meta="Project Lighthouse · Transaction Documents · 11 versions" stages={stages} tags={['v1–3', 'v4', 'v5–8', 'v9', 'v11']} current={4} progress="100%" />
    <Program title="Disclosure Letter" meta="Project Lighthouse · Transaction Documents · 6 versions" stages={stages} current={3} progress="70%" />
    <Program title="Escrow Agreement" meta="Project Lighthouse · Closing Set · 3 versions" stages={stages} current={1} progress="30%" />
  </div>
</section>
