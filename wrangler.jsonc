{
	// Deploys failed with "Missing entry-point to Worker script or to assets directory": the
	// Cloudflare deploy step runs `npx wrangler versions upload`, which needs this file to know
	// the Worker name and where the built site is. Without it the build succeeded and the deploy
	// died every time.
	//
	// One server route (src/pages/api/inquiry.ts) runs as a Worker; every page is still
	// prerendered. `main` is the entry @astrojs/cloudflare emits. Images are STILL optimised at
	// build time — the adapter is pinned to imageService build:'compile', runtime:'passthrough',
	// so nothing depends on a request-time image endpoint. See tools/check-images.mjs.
	"name": "lucio-astro",
	"compatibility_date": "2026-09-07",
	// No "main" here on purpose: @astrojs/cloudflare + @cloudflare/vite-plugin inject the worker
	// entry themselves and emit a generated dist/_worker.js/wrangler.json for deployment. Setting
	// main here breaks `astro dev`/`astro check`, because the plugin validates the path before any
	// build has produced it.
	"assets": {
		// With the SSR adapter, Astro splits output: dist/client is the browser-facing files,
		// dist/server holds the Worker. The adapter emits dist/server/wrangler.json with these
		// paths rewritten relative to itself, and that generated file is what gets deployed.
		"directory": "./dist/client",
		// Assets win over the Worker, so prerendered pages are served straight from the edge and
		// only /api/* actually invokes server code.
		"not_found_handling": "404-page"
	},
	"d1_databases": [
		{
			// One binding, named DB — src/pages/api/inquiry.ts reads it as env.DB.
			// `wrangler d1 create` appended a second binding of its own ("lucio_inquiries")
			// pointing at the same database; two bindings for one DB is just confusing, so this
			// keeps the named one the code actually uses.
			"binding": "DB",
			"database_name": "lucio-inquiries",
			"database_id": "f65a4550-9a37-4fb0-b6e6-4da4ce3a6228",
			"migrations_dir": "migrations"
		}
	],
	// Mirrors what the dashboard already has enabled, so dashboard and repo don't drift.
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}